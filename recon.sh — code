
#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <authorized-lab-target-ip>"
  exit 1
fi

TARGET="$1"

if [[ ! "$TARGET" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
  echo "Please enter a valid IPv4 address."
  exit 1
fi

mkdir -p results
STAMP="$(date +%Y%m%d_%H%M%S)"
OUT="results/nmap_${STAMP}.txt"

echo "[+] Target: $TARGET"
echo "[+] Starting authorized lab scan..."

nmap -sV --top-ports 100 "$TARGET" -oN "$OUT"

echo "[+] Scan complete!"
echo "[+] Results saved to: $OUT"
